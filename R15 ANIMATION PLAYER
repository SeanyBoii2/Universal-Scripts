local function makebutton(data, index)
	local button = Instance.new("TextButton")
	button["Name"] = data.name
	button["Size"] = UDim2.new(1, 0, 1, 0)
	button["BackgroundColor3"] = DEFAULT_BTN_COLOR
	button["Text"] = data.name
	button["TextColor3"] = Color3.fromRGB(200, 200, 210)
	button["TextSize"] = 10
	button["TextWrapped"] = true
	button["Font"] = Enum.Font.GothamSemibold
	button["BorderSizePixel"] = 0
	button["LayoutOrder"] = index
	button["Parent"] = buttoncontainer

	local corner = Instance.new("UICorner")
	corner["CornerRadius"] = UDim.new(0, 5)
	corner["Parent"] = button

	-- hover effects (only when not the active/green button)
	button["MouseEnter"]:Connect(function()
		if button ~= selectedButton then
			tweenservice:Create(button, TweenInfo.new(0.15), {["BackgroundColor3"] = HOVER_BTN_COLOR}):Play()
		end
	end)
	button["MouseLeave"]:Connect(function()
		if button ~= selectedButton then
			tweenservice:Create(button, TweenInfo.new(0.15), {["BackgroundColor3"] = DEFAULT_BTN_COLOR}):Play()
		end
	end)

	button["MouseButton1Click"]:Connect(function()
		clik()
		-- Update G-cycle index to match this button
		currentGIndex = index
		highlightButton(button)
		playAnimation(data)
	end)

	allButtons[index] = button
end

for i, anim in ipairs(animations) do
	makebutton(anim, i)
end

