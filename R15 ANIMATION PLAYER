local function playAnimation(data)
	if not localplayer.Character then return end
	local humanoid = localplayer.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	-- Stop our previously active custom animations
	for _, track in pairs(active) do
		if track then track:Stop(0) end
	end
	active = {}

	-- Stop previous keep-stopping loop
	if keepStoppingConnection then
		keepStoppingConnection:Disconnect()
		keepStoppingConnection = nil
	end

	-- Disable Animate LocalScript
	local animateScript = localplayer.Character:FindFirstChild("Animate")
	if animateScript then
		animateScript.Disabled = true
		animateWasDisabled = true
	end

	-- Stop every track instantly (twice to catch respawns)
	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do track:Stop(0) end
	task.wait()
	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do track:Stop(0) end

	-- Resolve the real animation ID (handles both raw anim IDs and emote catalog IDs)
	local realId = resolveAnimationId(data.id)

	-- Play our animation
	local animation = Instance.new("Animation")
	animation.AnimationId = "rbxassetid://" .. realId

	local ourTrack = animator:LoadAnimation(animation)
	ourTrack.Priority = Enum.AnimationPriority.Action4
	ourTrack:Play(0)
	ourTrack.Looped = data.looped
	ourTrack.TimePosition = data.timepos
	ourTrack:AdjustSpeed(data.speed)
	ourTrack:AdjustWeight(999)

	active[data.id] = ourTrack

	-- Keep killing other tracks (throttled to avoid frame drops)
	local killClock = 0
	keepStoppingConnection = runservice.Heartbeat:Connect(function(dt)
		if not ourTrack or not ourTrack.IsPlaying then
			if keepStoppingConnection then
				keepStoppingConnection:Disconnect()
				keepStoppingConnection = nil
			end
			return
		end
		killClock = killClock + dt
		if killClock < 0.2 then return end
		killClock = 0
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			if track ~= ourTrack then track:Stop(0) end
		end
	end)
end

