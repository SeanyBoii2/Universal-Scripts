local DEFAULT_BTN_COLOR = Color3.fromRGB(34, 34, 42)
local HOVER_BTN_COLOR   = Color3.fromRGB(44, 44, 54)
local ACTIVE_BTN_COLOR  = Color3.fromRGB(30, 140, 60)

-------------------------------------------------------------------------------------------------------------------------------
-- Resolve emote catalog IDs → real animation IDs
-- Emote assets contain an Animation object inside; raw animation IDs just work directly.
-------------------------------------------------------------------------------------------------------------------------------

local resolvedCache = {}

local function resolveAnimationId(assetId)
	if resolvedCache[assetId] then return resolvedCache[assetId] end

	local ok, objects = pcall(function()
		return game:GetObjects("rbxassetid://" .. assetId)
	end)

	if ok and objects then
		for _, obj in ipairs(objects) do
			-- The emote asset itself might be an Animation
			if obj:IsA("Animation") and obj.AnimationId ~= "" then
				local realId = obj.AnimationId:match("%d+")
				if realId then
					resolvedCache[assetId] = realId
					return realId
				end
			end
			-- Or the Animation could be a child of the emote wrapper
			for _, child in ipairs(obj:GetDescendants()) do
				if child:IsA("Animation") and child.AnimationId ~= "" then
					local realId = child.AnimationId:match("%d+")
					if realId then
						resolvedCache[assetId] = realId
						return realId
					end
				end
			end
		end
	end

	-- Fallback: assume it's already a direct animation ID
	resolvedCache[assetId] = tostring(assetId)
	return tostring(assetId)
end

-- Pre-resolve all emote IDs in background so clicking is instant (no freeze)
task.spawn(function()
	for _, anim in ipairs(animations) do
		resolveAnimationId(anim.id)
		task.wait()  -- yield between each to avoid stutter
	end
end)

