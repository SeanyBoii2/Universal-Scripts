-- G KEY CYCLING
-------------------------------------------------------------------------------------------------------------------------------

userinputservice["InputBegan"]:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input["KeyCode"] == Enum.KeyCode.G then
		if #animations == 0 then return end

		-- Advance to next (or start at 1)
		currentGIndex = currentGIndex + 1
		if currentGIndex > #animations then
			currentGIndex = 1
		end

		clik()
		highlightButton(allButtons[currentGIndex])
		playAnimation(animations[currentGIndex])

		-- Scroll the button into view
		local btn = allButtons[currentGIndex]
		if btn then
			local yPos = btn["AbsolutePosition"]["Y"] - buttoncontainer["AbsolutePosition"]["Y"]
			scrollframe["CanvasPosition"] = Vector2.new(0, math.max(0, yPos - 40))
		end
	end
end)

