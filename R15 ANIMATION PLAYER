local function highlightButton(btn)
	-- Reset old selection
	if selectedButton and selectedButton ~= btn then
		selectedButton["BackgroundColor3"] = DEFAULT_BTN_COLOR
	end
	-- Set new selection green
	if btn then
		btn["BackgroundColor3"] = ACTIVE_BTN_COLOR
	end
	selectedButton = btn
end

